# Maintainer: trihieuvo
# Personal fork of fortime/fcitx5-osk (MIT, Copyright (c) 2024 fortime).

_pkgbase=fcitx5-osk-custom
pkgname=fcitx5-osk-custom-git
_pkgver=0.2.1
pkgver=0.2.1
pkgrel=1
pkgdesc='Personal fork of fcitx5-osk, an on-screen keyboard for Fcitx5, with themes, auto show/hide, key feedback and more settings'
url='https://github.com/trihieuvo/fcitx5-osk-custom'
source=("$_pkgbase::git+https://github.com/trihieuvo/fcitx5-osk-custom#branch=main")
arch=('x86_64')
license=('MIT')
makedepends=('cargo' 'git' 'cmake')
# Disable lto in `makepkg`, otherwise, aws_lc can't be built
options=(!lto)
depends=('fcitx5' 'ttf-font-nerd' 'alsa-lib' 'openssl')
optdepends=('kwin: needed by kwin launcher')
# It installs the same files as the original package, so it replaces it.
provides=('fcitx5-osk' 'fcitx5-osk-git')
conflicts=('fcitx5-osk' 'fcitx5-osk-git')
sha256sums=(SKIP)

pkgver() {
  cd "$srcdir/$_pkgbase"
  if git describe --long --tags >/dev/null 2>&1; then
    git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '%s.r%s.g%s' "$_pkgver" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

prepare() {
  cd "$_pkgbase"
  # We use a patched iced_layershell, so we can't use --offline
  cargo fetch --target "$(rustc -vV | sed -n 's|host: ||p')"
}

build () {
  cmake \
      -D CMAKE_INSTALL_PREFIX=/usr \
      -D DBUS_CONFIG_PARENT_DIR=/usr/share \
      -B "${srcdir}/build-${_pkgver}" \
      -S "$srcdir/$_pkgbase"
  cmake --build "${srcdir}/build-${_pkgver}"
}

package() {
  DESTDIR="$pkgdir" cmake --install "${srcdir}/build-${_pkgver}" --component Fcitx5Osk
}
